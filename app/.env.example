# Copy to .env for local work. Never commit real values.
# Postgres connection string (Supabase pooler URL, Frankfurt). Empty means no database.
DATABASE_URL=
# Supabase project URL and publishable (anon) key, used for signup, login and the emailed links.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role (secret) key. Only for local scripts (scripts/staff.js). Never set it in Netlify.
SUPABASE_SERVICE_ROLE_KEY=
# Netlify needs only the three above the service role key. It sets URL (the site's main address) itself.
