---
// An instructor's Spotify playlist, loaded with the page (Antun, 2026-11-19: no click first). Spotify's own player,
// so it sets Spotify cookies on load: the privacy page has to name Spotify. Without a playlist id it is a Placeholder.
// The embed lays itself out by its width, so the box is capped on desktop and full width on a phone.
import Placeholder from '~/components/client/Placeholder.astro';
import { getCopy } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
  first: string;
  playlist: string | null;
}

const { lang, first, playlist } = Astro.props;
const t = getCopy(lang).instructorPage;
---

{
  playlist ? (
    <div data-playlist={playlist} class="w-full max-w-xl">
      <iframe
        src={`https://open.spotify.com/embed/playlist/${encodeURIComponent(playlist)}`}
        title={`${t.playlist}: ${first}`}
        width="100%"
        height="352"
        loading="lazy"
        allow="encrypted-media"
        class="block rounded-xl border-0"
      />
      <noscript>
        <a class="font-semibold text-link underline" href={`https://open.spotify.com/playlist/${playlist}`}>
          Spotify
        </a>
      </noscript>
    </div>
  ) : (
    <Placeholder lang={lang} label={`${first} Spotify playlist id (Dunia doc item 1)`} />
  )
}
