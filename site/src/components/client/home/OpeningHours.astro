---
// Address and opening hours as a card: on the waitlist page, and on Kontakt (`stacked`, one column beside the form).
import { contact } from '~/data/contact';
import { getCopy } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
  stacked?: boolean;
}

const { lang, stacked = false } = Astro.props;
const t = getCopy(lang).waitlist;
---

<section data-section="hours" class:list={[!stacked && 'mx-auto max-w-3xl px-4 sm:px-6 py-12 md:py-16']}>
  <div
    class:list={[
      'rounded-(--aw-radius-card) border border-white/10 bg-accent p-6 sm:p-8',
      !stacked && 'md:grid md:grid-cols-[1fr_1.25fr] md:items-center md:gap-14',
    ]}
  >
    <div>
      <h2 class="text-3xl font-extrabold leading-tight text-balance text-heading">{t.hoursHeading}</h2>
      <p class="mt-3 flex items-center gap-2 text-default" data-contact="address">
        <svg
          class="flex-none opacity-70"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{contact.address}</span>
      </p>
    </div>
    <ul class:list={['mt-6', !stacked && 'md:mt-0']} data-contact="hours">
      {
        contact.hours.map((h) => (
          <li
            class:list={[
              'flex justify-between gap-4 border-t border-gray-200 dark:border-slate-600 py-3 tabular-nums text-default',
              !stacked && 'md:first:border-t-0 md:first:pt-0',
            ]}
          >
            <span class="font-semibold text-heading">{h.days[lang]}</span>
            <span>{h.time}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
